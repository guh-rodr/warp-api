generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  refreshToken RefreshToken?
}

model RefreshToken {
  id        String      @id @default(cuid())
  token     String
  userId    String      @unique
  createdAt DateTime    @default(now())
  expiresAt DateTime
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String?
  note        String?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  payments    Payment[]
  receivables Receivable[]
  sales       Sale[]
}

model SaleItem {
  id           String         @id @default(cuid())
  saleId       String
  variantId    String
  categoryName String
  costPrice    Int
  salePrice    Int
  productName  String
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])
}

model ProductVariant {
  id             String          @id @default(cuid())
  color          String          @default("")
  size           String          @default("")
  costPrice      Int?
  salePrice      Int?
  quantity       Int
  productId      String
  deletedAt      DateTime?
  averageCost    Int?
  product        Product         @relation(fields: [productId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([productId, color, size])
}

model Product {
  id         String           @id @default(cuid())
  name       String
  categoryId String?
  isVariable Boolean          @default(false)
  deletedAt  DateTime?
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model StockMovement {
  id        String              @id @default(cuid())
  type      StockMovementType
  origin    StockMovementOrigin
  reason    String?
  unitCost  Int?
  quantity  Int
  variantId String
  saleId    String?
  date      DateTime            @default(now())
  createdAt DateTime            @default(now())
  sale      Sale?               @relation(fields: [saleId], references: [id])
  variant   ProductVariant      @relation(fields: [variantId], references: [id])
}

model CashFlowTransaction {
  id           String               @id @default(cuid())
  description  String
  value        Int
  category     String
  date         DateTime
  createdAt    DateTime             @default(now())
  paymentId    String?
  flow         TransactionDirection
  origin       TransactionOrigin
  payment      Payment?             @relation(fields: [paymentId], references: [id])
  reversalOfId String?              @unique
  reversalOf   CashFlowTransaction? @relation("CashFlowReversal", fields: [reversalOfId], references: [id])
  reversedBy   CashFlowTransaction? @relation("CashFlowReversal")
}

model Sale {
  id             String          @id @default(cuid())
  total          Int
  profit         Int
  customerId     String?
  createdAt      DateTime        @default(now())
  purchasedAt    DateTime
  receivables    Receivable[]
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  stockMovements StockMovement[]
}

model Payment {
  id           String                @id @default(cuid())
  customerId   String?
  method       PaymentMethod
  total        Int
  paidAt       DateTime
  createdAt    DateTime              @default(now())
  reversedAt   DateTime?
  transactions CashFlowTransaction[]
  customer     Customer?             @relation(fields: [customerId], references: [id])
  allocations  PaymentAllocation[]
}

model PaymentAllocation {
  id           String     @id @default(cuid())
  amount       Int
  paymentId    String
  receivableId String
  payment      Payment    @relation(fields: [paymentId], references: [id])
  receivable   Receivable @relation(fields: [receivableId], references: [id])
}

model Receivable {
  id               String              @id @default(cuid())
  type             ReceivableType
  status           ReceivableStatus
  total            Int
  paid             Int                 @default(0)
  installmentIdx   Int?
  installmentCount Int?
  customerId       String?
  saleId           String
  paidAt           DateTime?
  dueDate          DateTime?
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?
  allocations      PaymentAllocation[]
  customer         Customer?           @relation(fields: [customerId], references: [id])
  sale             Sale                @relation(fields: [saleId], references: [id])
}

view CustomerStats {
  id             String
  name           String
  phone          String
  createdAt      DateTime
  totalSpent     BigInt
  debt           BigInt
  lastPurchaseAt DateTime? @db.Timestamp(6)
}

view SaleStats {
  customerName String
  customerId   String
  id           String
  total        Int
  profit       Int
  purchasedAt  DateTime
  createdAt    DateTime
  itemCount    BigInt
  status       String
}

view ProductStats {
  id           String
  name         String
  categoryId   String
  categoryName String
  isVariable   Boolean
  variantCount Int
  quantity     Int
  minSalePrice Int
  maxSalePrice Int
}

view CashFlowStats {
  id          String
  description String
  flow        TransactionDirection
  value       Int
  category    String
}

view StockMovementStats {
  id           String
  type         StockMovementType
  saleId       String?
  unitCost     Int?
  quantity     Int
  origin       StockMovementOrigin
  date         DateTime
  reason       String?
  balance      Int
  productId    String
  productName  String
  variantId    String
  variantSize  String
  variantColor String
}

enum TransactionOrigin {
  MANUAL
  PAYMENT
}

enum StockMovementType {
  ENTRY
  EXIT
}

enum StockMovementOrigin {
  MANUAL
  SALE
  PURCHASE
}

enum TransactionDirection {
  INFLOW
  OUTFLOW
}

enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  PAID
}

enum ReceivableType {
  IMMEDIATE
  INSTALLMENT
  TAB
}
