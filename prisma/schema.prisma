// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  refreshToken RefreshToken?
}

model RefreshToken {
  id        String      @id @default(cuid())
  token     String
  userId    String      @unique
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  expiresAt DateTime
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model SaleItem {
  id           String         @id @default(cuid())
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId       String
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  categoryName String
  costPrice    Int
  salePrice    Int
}

model ProductVariant {
  id             String          @id @default(cuid())
  color          String          @default("")
  size           String          @default("")
  averageCost    Int?
  costPrice      Int?
  salePrice      Int?
  quantity       Int
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  saleItems      SaleItem[]
  deletedAt      DateTime?
  stockMovements StockMovement[]

  @@unique([productId, color, size])
}

model Product {
  id         String           @id @default(cuid())
  name       String
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  isVariable Boolean          @default(false)
  variants   ProductVariant[]
  deletedAt  DateTime?
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

enum StockMovementType {
  ENTRY
  EXIT
}

enum StockMovementOrigin {
  MANUAL
  SALE
  PURCHASE
}

model StockMovement {
  id        String              @id @default(cuid())
  type      StockMovementType
  origin    StockMovementOrigin
  reason    String?
  unitCost  Int?
  quantity  Int
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  saleId    String?
  sale      Sale?               @relation(fields: [saleId], references: [id])
  date      DateTime            @default(now())
  createdAt DateTime            @default(now())
}

model CashFlowTransaction {
  id          String   @id @default(cuid())
  description String
  value       Int
  flow        String
  category    String
  date        DateTime
  createdAt   DateTime @default(now())
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId      String?
}

model Sale {
  id             String                @id @default(cuid())
  total          Int
  profit         Int
  items          SaleItem[]
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId     String?
  createdAt      DateTime              @default(now())
  purchasedAt    DateTime?
  isInstallment  Boolean
  transactions   CashFlowTransaction[]
  stockMovements StockMovement[]
}

view CustomerStats {
  id             String
  name           String
  phone          String
  totalSpent     Int
  debt           Int
  lastPurchaseAt DateTime?
  createdAt      DateTime  @default(now())
}

view SaleStats {
  id           String
  customerName String
  customerId   String
  status       String
  total        Int
  profit       Int
  itemCount    Int
  purchasedAt  DateTime
  createdAt    DateTime
}

view CashFlowStats {
  id          String
  description String
  category    String
  value       Int
  flow        String
  saleId      String?
  date        DateTime
  createdAt   DateTime
}

view ProductStats {
  id           String
  name         String
  categoryId   String
  categoryName String
  isVariable   Boolean
  variantCount Int
  quantity     Int
  minSalePrice Float
  maxSalePrice Float
}

view StockMovementStats {
  id           String
  type         StockMovementType
  origin       StockMovementOrigin
  quantity     Int
  balance      Int
  date         DateTime
  unitCost     Int?
  reason       String?
  productId    String
  productName  String
  variantId    String
  variantSize  String
  variantColor String
}
